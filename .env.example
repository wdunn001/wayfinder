# Wayfinder runtime configuration, copy to `.env` and edit, then run:
#   docker run -d -p 8442:80 --env-file .env wayfinder
#
# TWO kinds of settings:
#   *_UPSTREAM, "host:port" of a same-origin backend nginx proxies to. Use an
#                 IP:port (not a DNS name) so nginx never blocks on DNS at boot.
#   WAYFINDER_*, feature toggles. At container start the entrypoint regenerates
#                 web/config.js from these; the frontend removes the UI for any
#                 disabled feature so it never calls a backend you don't run.
#
# Anything left UNSET falls back to a built-in default (see the Dockerfile):
# upstreams default to a loopback placeholder (so the container still boots and
# those routes just return 502 until you configure them); feature flags use the
# defaults noted below. The static map + geofence layers work with zero config.


# ─── Backend upstreams (host:port nginx proxies to) ────────────────────────────

# Raster basemap / satellite tiles. Powers the street & satellite basemaps.
# Required for the map to show tiles. A tile server (e.g. TileServer-GL) or a
# static tile cache.
TILES_UPSTREAM=tiles.example.internal:8080

# Martin vector-tile server. Required for WAYFINDER_3D (the `buildings` layer
# carries height data for 3D fill-extrusion).
MARTIN_UPSTREAM=martin.example.internal:3000

# Nominatim geocoder (primary address search, house-number accurate). Required
# for core address search; the app falls back to Photon below if it 502s.
NOMINATIM_UPSTREAM=nominatim.example.internal:8080

# Photon geocoder (fallback place-name search). Required for core address search.
PHOTON_UPSTREAM=photon.example.internal:2322

# OSRM routing engine (route + trip optimization). Required for directions.
OSRM_UPSTREAM=osrm.example.internal:5000

# Overpass API (self-hosted OSM extract). Used by WAYFINDER_POI as the primary
# places source (TomTom is the fallback). Optional.
OVERPASS_UPSTREAM=overpass.example.internal:80

# Voice stack, all OPTIONAL, only used when WAYFINDER_VOICE=true.
# Text-to-speech HTTP bridge (e.g. Piper), POST {text} -> {audio:b64}.
TTS_UPSTREAM=tts.example.internal:8080
# Speech-to-text (e.g. Whisper ASR webservice).
STT_UPSTREAM=stt.example.internal:8080
# LLM with an Ollama-compatible /api/generate (normalizes a spoken phrase).
LLM_UPSTREAM=llm.example.internal:11434


# ─── TomTom (optional live traffic + POI fallback) ─────────────────────────────

# TomTom API key. Required for WAYFINDER_TRAFFIC and for the TomTom POI paths.
# The key stays server-side (nginx appends it) and never reaches the browser.
# Leave blank if you don't use TomTom features.
TOMTOM_API_KEY=

# If your TomTom key is domain-restricted (allow-listed to a referer), set this
# to a matching origin (e.g. https://maps.example.com/). nginx sends it as the
# Referer header server-side, so the browser's real origin doesn't matter.
# Leave blank for an unrestricted key.
TOMTOM_REFERER=


# ─── NWS weather (optional; US only) ───────────────────────────────────────────

# api.weather.gov asks callers to identify themselves. Set an app name + a
# contact you control. Only used when WAYFINDER_WEATHER=true.
NWS_USER_AGENT=wayfinder (you@example.com)


# ─── Feature flags ─────────────────────────────────────────────────────────────
# Accepted truthy values: true / 1 / on / yes (case-insensitive). Anything else
# is false. Unset => the default shown.

# Live traffic overlay + traffic-aware ETA. Needs TOMTOM_API_KEY. Default: false
WAYFINDER_TRAFFIC=false

# "Find places" POI search. Needs Overpass (OVERPASS_UPSTREAM) and/or a TomTom
# key. Default: false
WAYFINDER_POI=false

# Voice search + spoken turn-by-turn guidance. Needs the TTS/STT/LLM upstreams
# above. Default: false
WAYFINDER_VOICE=false

# NWS weather alerts + current conditions (US only; degrades gracefully
# offline). Needs NWS_USER_AGENT. Default: true
WAYFINDER_WEATHER=true

# 3D buildings + terrain. Needs MARTIN_UPSTREAM (buildings) and internet for the
# public terrarium DEM. Default: true
WAYFINDER_3D=true

# Satellite imagery basemap. Needs TILES_UPSTREAM. Default: true
WAYFINDER_SATELLITE=true

# Terra Draw geofence layers. Self-contained (localStorage), no backend.
# Default: true
WAYFINDER_GEOFENCE=true
